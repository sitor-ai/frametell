{
  "name": "frametell",
  "version": "0.7.4",
  "private": true,
  "description": "Tell stories, frame by frame. Turn your ideas and material into vivid explainer videos with an AI director. Local-first, any model.",
  "license": "AGPL-3.0-only",
  "author": "Sitor Team (https://sitor.ai)",
  "homepage": "https://github.com/sitor-ai/frametell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitor-ai/frametell.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/sitor-ai/frametell/issues"
  },
  "keywords": [
    "explainer video",
    "ai video",
    "agent",
    "storyboard",
    "narration",
    "tts",
    "frametell"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "bin": {
    "frametell": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "dev": "node dist/cli.js"
  },
  "dependencies": {
    "@frametell/agent": "workspace:*",
    "@frametell/engine": "workspace:*",
    "@frametell/models": "workspace:*",
    "@frametell/voice": "workspace:*",
    "@hono/node-server": "1.19.5",
    "hono": "4.9.12",
    "@frametell/core": "workspace:*",
    "@frametell/ui": "workspace:*"
  }
}
