{
  "name": "@frametell/core",
  "version": "0.7.4",
  "private": true,
  "description": "Frametell's application core: settings, projects and their runs, events. Transport-agnostic; the CLI serves it over HTTP and the desktop app over IPC.",
  "license": "AGPL-3.0-only",
  "author": "Sitor Team (https://sitor.ai)",
  "homepage": "https://github.com/sitor-ai/frametell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitor-ai/frametell.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sitor-ai/frametell/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@frametell/agent": "workspace:*",
    "@frametell/engine": "workspace:*",
    "@frametell/models": "workspace:*",
    "@frametell/voice": "workspace:*",
    "jszip": "3.10.1",
    "mammoth": "1.12.3",
    "undici": "7.30.0",
    "unpdf": "1.8.1"
  }
}
