{
  "name": "@frametell/agent",
  "version": "0.7.4",
  "private": true,
  "description": "The Frametell director: staged agent runs (storyboard, narration script, pages, review) on Pi, the Claude Agent SDK or the Codex SDK, with lint and frame checks enforced by the orchestrator.",
  "license": "AGPL-3.0-only",
  "author": "Sitor Team (https://sitor.ai)",
  "homepage": "https://github.com/sitor-ai/frametell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitor-ai/frametell.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/sitor-ai/frametell/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime/claude": {
      "types": "./dist/runtime/claude.d.ts",
      "default": "./dist/runtime/claude.js"
    },
    "./runtime/codex": {
      "types": "./dist/runtime/codex.d.ts",
      "default": "./dist/runtime/codex.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@frametell/engine": "workspace:*",
    "@frametell/models": "workspace:*",
    "@frametell/voice": "workspace:*",
    "typebox": "^1.3.36"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@openai/codex-sdk": "0.162.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@openai/codex-sdk": "0.162.1"
  }
}
